/* ===== 首页 ===== */
.page-home {
  text-align: center;
  padding-top: 18vh;
  background: #5B8C5A;
  min-height: 100vh;
}

.mascot {
  display: block;
  margin: 0 auto 32rpx;
  width: 340rpx;
  height: 216rpx;
}

.home-title {
  font-size: 76rpx;
  color: #FFFFFF;
  margin-bottom: 16rpx;
  letter-spacing: 8rpx;
  font-weight: bold;
}

.home-subtitle {
  color: rgba(255,255,255,0.5);
  font-size: 24rpx;
  margin-bottom: 96rpx;
  letter-spacing: 4rpx;
}

/* 首页按钮 - 米白色 */
.btn-home {
  color: #5B8C5A !important;
  background-color: #FFFDF7 !important;
}

/* 通用按钮 */
.btn {
  display: inline-block;
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  background-color: #5B8C5A;
  border: none;
  border-radius: 28rpx;
  padding: 32rpx 128rpx;
  letter-spacing: 6rpx;
  line-height: 1;
}

.btn:active {
  opacity: 0.85;
}

/* ===== 公众号推广 ===== */
.wechat-promo {
  position: fixed;
  right: 32rpx;
  bottom: 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.wechat-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.8);
}

.wechat-name {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}

.wechat-desc {
  font-size: 18rpx;
  color: rgba(255,255,255,0.5);
}

/* ===== 问答页 ===== */
.page-quiz {
  padding: 16vh 40rpx 0;
  min-height: 100vh;
  background: #FAF7F2;
}

.quiz-progress {
  width: 100%;
  height: 6rpx;
  background: #E8E8E8;
  border-radius: 3rpx;
  margin-bottom: 64rpx;
}

.quiz-progress-bar {
  height: 100%;
  background: #5B8C5A;
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

.question-text {
  font-size: 44rpx;
  font-weight: 600;
  color: #333333;
  text-align: center;
  margin-bottom: 16rpx;
}

.question-hint {
  text-align: center;
  color: #AAAAAA;
  font-size: 24rpx;
  margin-bottom: 56rpx;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-btn {
  display: flex;
  align-items: center;
  gap: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
  background: #FFFFFF;
  border: 3rpx solid #EEEEEE;
  border-radius: 28rpx;
  padding: 32rpx 40rpx;
  text-align: left;
  line-height: 1;
}

.option-btn:active {
  background: #F4FAF4;
  border-color: #5B8C5A;
}

.option-number {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #EEF5EE;
  color: #5B8C5A;
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* 返回上一题 */
.back-row {
  text-align: center;
  margin-top: 48rpx;
}

.back-btn {
  font-size: 28rpx;
  color: #999999;
  background: none;
  border: none;
  padding: 20rpx 40rpx;
  letter-spacing: 2rpx;
  line-height: 1;
}

/* ===== 结果页 ===== */
.page-result {
  padding: 40rpx 40rpx 0;
  min-height: 100vh;
  background: #FAF7F2;
}

.result-title {
  font-size: 52rpx;
  color: #333333;
  text-align: center;
  margin-bottom: 12rpx;
  letter-spacing: 4rpx;
  font-weight: bold;
}

.result-subtitle {
  text-align: center;
  color: #AAAAAA;
  font-size: 24rpx;
  margin-bottom: 48rpx;
}

.result-cards {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 56rpx;
}

.result-card {
  display: flex;
  gap: 28rpx;
  align-items: center;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 32rpx rgba(0,0,0,0.04);
}

.result-card-img {
  width: 120rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: #FAFAFA;
  flex-shrink: 0;
}

.result-card-placeholder {
  width: 120rpx;
  height: 160rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.result-card-info {
  flex: 1;
}

.result-card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 6rpx;
}

.result-card-desc {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 4rpx;
}

.result-card-meta {
  font-size: 22rpx;
  color: #BBBBBB;
}
