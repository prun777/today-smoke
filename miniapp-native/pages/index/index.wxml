<!-- ===== 首页 ===== -->
<view class="page-home" wx:if="{{screen=='home'}}">
  <image class="mascot" src="{{mascotUrl}}" mode="aspectFit"></image>
  <view class="home-title">今天抽什么烟</view>
  <view class="home-subtitle">今天适合来一根什么？</view>
  <button class="btn btn-home" bindtap="onStart">开始</button>

  <!-- 公众号推广 -->
  <view class="wechat-promo">
    <image class="wechat-avatar" src="{{prunUrl}}" mode="aspectFill"></image>
    <text class="wechat-name">prun</text>
    <text class="wechat-desc">关注微信公众号</text>
  </view>
</view>

<!-- ===== 问答页 ===== -->
<view class="page-quiz" wx:if="{{screen=='quiz'}}">
  <view class="quiz-progress">
    <view class="quiz-progress-bar" style="width:{{progressPercent}}%"></view>
  </view>
  <view class="question-text">{{questionText}}</view>
  <view class="question-hint">{{questionHint}}</view>

  <view class="options-list">
    <button
      wx:for="{{options}}"
      wx:key="index"
      class="option-btn"
      bindtap="onSelect"
      data-option="{{item}}"
    >
      <view class="option-number">{{index+1}}</view>
      <text>{{item}}</text>
    </button>
  </view>

  <view class="back-row" wx:if="{{showBack}}">
    <button class="back-btn" bindtap="onBack">← 上一题</button>
  </view>
</view>

<!-- ===== 结果页 ===== -->
<view class="page-result" wx:if="{{screen=='result'}}">
  <view class="result-title">今日推荐</view>
  <view class="result-subtitle">根据你的选择，今天试试这几款</view>

  <view class="result-cards">
    <view class="result-card" wx:for="{{resultCards}}" wx:key="index">
      <image class="result-card-img" src="{{item.imgUrl}}" mode="aspectFit"></image>
      <view class="result-card-placeholder" wx:if="{{!item.imgLoaded}}" style="background-color:{{item.color}};">
        <text style="color:white;font-size:16px;font-weight:bold;">{{item.initials}}</text>
      </view>
      <view class="result-card-info">
        <view class="result-card-name">{{item.name}}</view>
        <view class="result-card-desc">{{item.desc}}</view>
        <view class="result-card-meta">{{item.brand}} · {{item.price}} · {{item.thickness}}</view>
      </view>
    </view>
  </view>

  <button class="btn" bindtap="onRetry">再测一次</button>
</view>
